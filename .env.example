# ====================== DISCORD ======================
DISCORD_TOKEN=ton_token_bot
CLIENT_ID=ton_client_id_application
GUILD_ID=ton_id_serveur   # optionnel mais recommandé pour le déploiement rapide

# ====================== SALONS ======================
# Salon où le bot met à jour la file d'attente en direct
QUEUE_CHANNEL_ID=id_salon_file_attente

# Salon où le bot envoie le classement des points (mis à jour régulièrement)
LEADERBOARD_CHANNEL_ID=id_salon_classement

# Salon vocal par défaut pour la radio / quiz (le bot rejoint celui de l'utilisateur si possible)
DEFAULT_VOICE_CHANNEL_ID=id_salon_vocal

# Salon où le bot envoie les logs / alertes
LOG_CHANNEL_ID=id_salon_logs

# ====================== RADIO ======================
# URL de ton flux radio (ex: https://stream.example.com/radio.mp3)
RADIO_URL=https://ice1.somafm.com/groovesalad-128-mp3

# ====================== QUIZ ======================
# Heure de Paris - le quiz se lance toutes les heures pile (ex: 14:00, 15:00...)
# Le bot utilise automatiquement Europe/Paris
QUIZ_DURATION_SECONDS=45
QUIZ_POINTS_CORRECT=15
QUIZ_POINTS_FAST=5
QUIZ_POINTS_PARTICIPATION=2

# ====================== POINTS ======================
# Points nécessaires pour chaque niveau (barre de progression)
POINTS_PER_LEVEL=100

# ====================== RÔLES (optionnel) ======================
ROLE_STAFF=id_role_staff
